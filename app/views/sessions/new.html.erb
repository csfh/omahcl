<% page_title "Sign in" %>

<h1 class="text-3xl font-semibold">Sign in</h1>

<%= form_with url: session_path, id: "signin", data: { turbo: false }, class: "mt-6 max-w-md space-y-5" do |form| %>
  <div>
    <%= form.label :email_address, "Email", for: "email", class: "text-sm text-muted" %>
    <%= form.email_field :email_address, id: "email", required: true, autofocus: true, autocomplete: "email", value: params[:email_address], class: field_class %>
  </div>
  <div>
    <%= form.label :password, for: "current-password", class: "text-sm text-muted" %>
    <%= form.password_field :password, id: "current-password", required: true, autocomplete: "current-password", maxlength: 72, class: field_class %>
  </div>
  <%= form.submit "Sign in", class: button_class %>
<% end %>
