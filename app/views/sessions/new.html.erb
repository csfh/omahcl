<% page_title "Sign in" %>

<h1 class="text-3xl font-semibold">Sign in</h1>

<%= form_with url: session_path, class: "mt-6 max-w-md space-y-5" do |form| %>
  <div>
    <%= form.label :email_address, "Email", class: "text-sm text-muted" %>
    <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address], class: field_class %>
  </div>
  <div>
    <%= form.label :password, class: "text-sm text-muted" %>
    <%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72, class: field_class %>
  </div>
  <div class="flex flex-wrap items-center gap-4">
    <%= form.submit "Sign in", class: button_class %>
    <%= link_to "Forgot password?", new_password_path, class: "text-sm" %>
  </div>
<% end %>

<p class="mt-6 text-sm text-muted">No account yet? <%= link_to "Sign up", new_registration_path %></p>
