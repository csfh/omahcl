<% page_title "Resend verification" %>

<h1 class="text-3xl font-semibold">Resend verification</h1>
<p class="mt-2 text-muted">We'll email a new link if this address still needs to be confirmed.</p>

<%= form_with url: email_verifications_path, id: "resend-verification", data: { turbo: false }, class: "mt-6 max-w-md space-y-5" do |form| %>
  <div>
    <%= form.label :email_address, "Email", for: "email", class: "text-sm text-muted" %>
    <%= form.email_field :email_address, id: "email", required: true, autofocus: true, autocomplete: "username", value: params[:email_address], class: field_class %>
  </div>
  <%= form.submit "Send verification link", class: button_class %>
<% end %>
