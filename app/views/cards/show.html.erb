<% page_title "#{@sample.display_name(short: true)} card" %>
<%= render "cards/og", title: "#{@sample.display_name(short: true)} is Omarchy Verified", url: card_url(params[:key]), key: params[:key], machines: @machines_count %>

<p class="wrap-anywhere text-sm text-muted"><%= link_to @sample.display_name, hardware_model_path(@sample.model_slug), class: "inline-flex min-h-11 items-center" %> · <%= @card[:cpu] %></p>
<h1 class="mt-2 heading-page">Omarchy Verified card</h1>
<p class="mt-2 text-muted">Share it, or tilt it around. It shows only what the model page already shows.</p>

<div class="mt-10 flex justify-center">
  <div class="holo-stage w-full max-w-xs" data-controller="holo-card">
    <article class="holo-card" data-holo-card-target="card" aria-label="Omarchy Verified: <%= @sample.display_name %>">
      <div class="holo-foil" aria-hidden="true"></div>
      <div class="holo-sparkle" aria-hidden="true"></div>
      <div class="holo-glare" aria-hidden="true"></div>

      <div class="holo-content">
        <p class="text-center font-pixel text-sm leading-relaxed text-accent">Omarchy Verified</p>

        <svg class="holo-seal" viewBox="0 0 <%= CardImage::SEAL_SIZE %> <%= CardImage::SEAL_SIZE %>" aria-hidden="true" shape-rendering="crispEdges">
          <path class="fill-teal-deep" d="<%= CardImage.cells_path(CardImage::OUTER) %>" />
          <path class="fill-accent" d="<%= CardImage.cells_path(CardImage::INNER) %>" />
          <path class="fill-ink" d="<%= CardImage.cells_path(CardImage::CHECK) %>" />
        </svg>

        <div>
          <h2 class="line-clamp-2 wrap-anywhere font-pixel text-xs leading-relaxed text-paper"><%= @sample.display_name %></h2>
          <dl class="mt-3 space-y-1 text-xs text-muted">
            <div class="flex justify-between gap-3"><dt>CPU</dt><dd class="min-w-0 line-clamp-2 wrap-anywhere text-right text-paper" title="<%= @card[:cpu] %>"><%= @card[:cpu] %></dd></div>
            <div class="flex justify-between gap-3"><dt>GPU</dt><dd class="min-w-0 line-clamp-2 wrap-anywhere text-right text-paper" title="<%= @card[:gpu] %>"><%= @card[:gpu] %></dd></div>
            <div class="flex justify-between gap-3"><dt>Omarchy</dt><dd class="min-w-0 wrap-anywhere text-right text-paper"><%= @card[:version] %></dd></div>
          </dl>
        </div>

        <p class="text-center text-[0.65rem] text-muted">omahcl.com</p>
      </div>
    </article>
  </div>
</div>

<p class="mt-8 text-center">
  <%= link_to "Download as an image (PNG)", card_path(params[:key], format: :png),
        class: ghost_button_class, download: "#{params[:key]}.png" %>
</p>
