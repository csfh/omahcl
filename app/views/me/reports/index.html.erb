<% page_title "Claimed reports" %>

<h1 class="text-3xl font-semibold">Claimed reports</h1>
<p class="mt-2 text-muted">Hardware snapshots you claimed after submitting from Omarchy.</p>

<% if @reports.any? %>
  <ul class="mt-8 divide-y divide-white/10 border-y border-white/10">
    <% @reports.each do |report| %>
      <li class="flex flex-wrap items-baseline justify-between gap-3 py-4">
        <div>
          <p><%= report.display_name %></p>
          <p class="text-sm text-muted"><%= memory_label(report.memory_bytes) %> · <%= report.cpu_model %></p>
        </div>
        <div class="text-sm">
          <% if report.open_listing %>
            <%= link_to report.open_listing.title, listing_path(report.open_listing) %>
            ·
            <%= link_to "Edit listing", edit_me_report_listing_path(report) %>
          <% else %>
            <%= link_to "List for sale or donation", new_me_report_listing_path(report) %>
          <% end %>
        </div>
      </li>
    <% end %>
  </ul>
<% else %>
  <p class="mt-8 text-muted">None yet. Run the collector on Omarchy, then open the claim link while signed in.</p>
  <pre class="mt-3 overflow-x-auto rounded-md bg-panel p-4 text-sm"><code><%= collect_command %></code></pre>
<% end %>
