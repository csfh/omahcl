<% page_title "Update password" %>

<h1 class="text-3xl font-semibold">Update your password</h1>

<%= form_with url: password_path(params[:token]), method: :put, id: "reset-password", data: { turbo: false }, class: "mt-6 max-w-md space-y-5" do |form| %>
  <%= text_field_tag :username, @user.email_address, id: "username", autocomplete: "username", readonly: true, tabindex: -1, class: "sr-only", aria: { hidden: true } %>
  <div>
    <%= form.label :password, "New password", for: "new-password", class: "text-sm text-muted" %>
    <%= form.password_field :password, id: "new-password", required: true, autocomplete: "new-password", maxlength: 72, passwordrules: "maxlength: 72;", class: field_class %>
  </div>
  <div>
    <%= form.label :password_confirmation, "Repeat password", for: "confirm-password", class: "text-sm text-muted" %>
    <%= form.password_field :password_confirmation, id: "confirm-password", required: true, autocomplete: "new-password", maxlength: 72, passwordrules: "maxlength: 72;", class: field_class %>
  </div>
  <%= form.submit "Save", class: button_class %>
<% end %>
