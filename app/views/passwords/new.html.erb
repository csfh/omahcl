<% page_title "Reset password" %>

<h1 class="text-3xl font-semibold">Forgot your password?</h1>

<%= form_with url: passwords_path, class: "mt-6 max-w-md space-y-5" do |form| %>
  <div>
    <%= form.label :email_address, "Email", class: "text-sm text-muted" %>
    <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address], class: field_class %>
  </div>
  <%= form.submit "Email reset instructions", class: button_class %>
<% end %>
