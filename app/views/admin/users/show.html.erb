<% page_title @user.email_address %>

<p class="text-sm text-muted"><%= link_to "All users", admin_users_path %></p>
<h1 class="mt-2 text-3xl font-semibold"><%= @user.email_address %></h1>
<p class="mt-2 text-muted"><%= @user.admin? ? "Admin" : "Inactive account. Only admins can sign in." %></p>

<div class="mt-6 flex flex-wrap gap-3">
  <% if @user.admin? %>
    <%= button_to "Revoke admin", revoke_admin_admin_user_path(@user), class: ghost_button_class + " cursor-pointer", form: { data: { turbo_confirm: "Revoke admin access?" } } %>
  <% else %>
    <%= button_to "Grant admin", grant_admin_admin_user_path(@user), class: ghost_button_class + " cursor-pointer" %>
  <% end %>
  <%= button_to "Delete account", admin_user_path(@user), method: :delete, class: ghost_button_class + " cursor-pointer", form: { data: { turbo_confirm: "Delete this account?" } } %>
</div>
