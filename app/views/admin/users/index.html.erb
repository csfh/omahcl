<% page_title "Users" %>

<h1 class="heading-page">Users</h1>

<%= form_with url: admin_users_path, method: :get, class: "mt-6 flex flex-wrap items-end gap-3" do |form| %>
  <div class="w-full sm:w-auto">
    <%= form.label :q, "Email", class: "text-sm text-muted" %>
    <%= form.search_field :q, value: @query, class: field_class %>
  </div>
  <div class="w-full sm:w-auto">
    <%= form.label :admin, "Role", class: "text-sm text-muted" %>
    <%= form.select :admin, [["All", ""], ["Admins", "yes"], ["Not admin", "no"]], { selected: @admin_filter }, class: field_class %>
  </div>
  <%= form.submit "Filter", class: button_class %>
<% end %>

<ul class="mt-8 divide-y-2 divide-line border-y-2 border-line">
  <% @users.each do |user| %>
    <li class="flex flex-wrap items-baseline justify-between gap-3 py-4">
      <div>
        <p><%= link_to user.email_address, admin_user_path(user) %></p>
        <p class="text-sm text-muted"><%= user.admin? ? "Admin" : "Inactive account" %></p>
      </div>
    </li>
  <% end %>
</ul>
