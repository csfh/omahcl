<% page_title @listing.title %>

<p class="text-sm text-muted"><%= link_to "All listings", admin_listings_path %></p>
<h1 class="mt-2 text-3xl font-semibold"><%= @listing.title %></h1>
<p class="mt-2 text-muted">
  <%= @listing.status.titleize %>
  ·
  <%= listing_kind_label(@listing) %>
  <% if @listing.sale? && listing_condition_label(@listing) %> · <%= listing_condition_label(@listing) %><% end %>
  <% if @listing.donation? && @listing.donation_destination %> · <%= @listing.donation_destination.name %><% end %>
</p>
<% if @listing.sale? && @listing.price %>
  <p class="mt-3 text-xl"><%= @listing.price %></p>
<% end %>
<p class="mt-1 text-muted"><%= @listing.report.display_name %> · <%= [@listing.city, @listing.country_code].compact.join(", ") %></p>
<p class="mt-1 text-muted"><%= @listing.user&.email_address || "No owner" %></p>

<% if @listing.photos.attached? %>
  <ul class="mt-8 grid gap-4 sm:grid-cols-2">
    <% @listing.photos.each do |photo| %>
      <li><%= image_tag photo, class: "w-full rounded-md", alt: @listing.title %></li>
    <% end %>
  </ul>
<% end %>

<% if @listing.description.present? %>
  <div class="prose-market mt-8 max-w-2xl">
    <%= simple_format @listing.description %>
  </div>
<% end %>

<p class="mt-8 text-sm">
  <%= link_to "Report", admin_report_path(@listing.report.public_id) %>
  <% if @listing.published? %>
    ·
    <%= link_to "Public listing", listing_path(@listing) %>
  <% end %>
</p>

<% if @listing.published? %>
  <%= button_to "Close listing", close_admin_listing_path(@listing), method: :post, class: ghost_button_class + " mt-6 cursor-pointer", form: { data: { turbo_confirm: "Close this listing?" } } %>
<% end %>
