<% page_title "Challenges" %>

<h1 class="text-3xl font-semibold">Challenges</h1>
<p class="mt-2 text-muted">Nonce tickets for hardware ingest. They expire after five minutes.</p>

<%= form_with url: admin_challenges_path, method: :get, class: "mt-6 flex flex-wrap items-end gap-3" do |form| %>
  <div>
    <%= form.label :status, "Status", class: "text-sm text-muted" %>
    <%= form.select :status, [["All", ""], ["Open", "open"], ["Consumed", "consumed"], ["Expired", "expired"]], { selected: @status }, class: field_class %>
  </div>
  <%= form.submit "Filter", class: button_class %>
<% end %>

<ul class="mt-8 divide-y divide-white/10 border-y border-white/10">
  <% @challenges.each do |challenge| %>
    <li class="flex flex-wrap items-baseline justify-between gap-3 py-4">
      <div>
        <p><%= link_to "Challenge #{challenge.id}", admin_challenge_path(challenge) %></p>
        <p class="text-sm text-muted">Issued <%= challenge.created_at.to_fs(:long) %></p>
      </div>
      <p class="text-sm text-muted"><%= challenge.status_label %></p>
    </li>
  <% end %>
</ul>
