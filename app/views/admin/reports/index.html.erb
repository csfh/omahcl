<% page_title "Reports" %>

<h1 class="text-3xl font-semibold">Reports</h1>

<%= form_with url: admin_reports_path, method: :get, class: "mt-6 flex flex-wrap items-end gap-3" do |form| %>
  <div>
    <%= form.label :q, "Machine", class: "text-sm text-muted" %>
    <%= form.search_field :q, value: @query, class: field_class %>
  </div>
  <div>
    <%= form.label :hidden, "Visibility", class: "text-sm text-muted" %>
    <%= form.select :hidden, [["All", ""], ["Public", "no"], ["Hidden", "yes"]], { selected: @hidden_filter }, class: field_class %>
  </div>
  <div>
    <%= form.label :source, "Source", class: "text-sm text-muted" %>
    <%= form.select :source, [["All", ""], ["Running Omarchy", "omarchy"], ["Candidates", "candidate"]], { selected: @source }, class: field_class %>
  </div>
  <%= form.submit "Filter", class: button_class %>
<% end %>

<ul class="mt-8 divide-y divide-white/10 border-y border-white/10">
  <% @reports.each do |report| %>
    <li class="flex flex-wrap items-baseline justify-between gap-3 py-4">
      <div>
        <p><%= link_to report.display_name, admin_report_path(report.public_id) %></p>
        <p class="text-sm text-muted"><%= memory_label(report.memory_bytes) %> · <%= report.cpu_model %></p>
      </div>
      <p class="text-sm text-muted"><%= report.source_candidate? ? "Candidate · " : "" %><%= report.hidden? ? "Hidden · " : "" %><%= report.updated_at.to_fs(:long) %></p>
    </li>
  <% end %>
</ul>
