<%= form_with model: [:admin, destination], class: "mt-6 max-w-xl space-y-5" do |form| %>
  <% if destination.errors.any? %>
    <div class="rounded-md border border-red-400/40 bg-red-400/10 px-3 py-2 text-sm text-red-200" role="alert">
      <ul class="list-disc pl-5">
        <% destination.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name, class: "text-sm text-muted" %>
    <%= form.text_field :name, required: true, class: field_class %>
  </div>
  <div>
    <%= form.label :url, class: "text-sm text-muted" %>
    <%= form.url_field :url, required: true, class: field_class %>
  </div>
  <div>
    <%= form.label :description, class: "text-sm text-muted" %>
    <%= form.text_area :description, rows: 4, class: field_class %>
  </div>
  <label class="flex items-center gap-2">
    <%= form.check_box :active %>
    Active
  </label>
  <%= form.submit class: button_class %>
<% end %>
