<% page_title "Donation destinations" %>

<div class="flex items-baseline justify-between gap-4">
  <h1 class="text-3xl font-semibold">Donation destinations</h1>
  <%= link_to "Add destination", new_admin_donation_destination_path, class: button_class + " no-underline text-ink" %>
</div>

<ul class="mt-8 divide-y divide-white/10 border-y border-white/10">
  <% @destinations.each do |destination| %>
    <li class="flex flex-wrap items-baseline justify-between gap-3 py-4">
      <div>
        <p><%= destination.name %> <% unless destination.active? %><span class="text-sm text-muted">(inactive)</span><% end %></p>
        <p class="text-sm text-muted"><%= destination.url %></p>
      </div>
      <div class="text-sm">
        <%= link_to "Edit", edit_admin_donation_destination_path(destination) %>
      </div>
    </li>
  <% end %>
</ul>
