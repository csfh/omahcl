<% page_title "Claim report" %>

<h1 class="text-3xl font-semibold">Claim this report</h1>
<p class="mt-3 text-muted">
  <%= @report.display_name %> submitted Omarchy <%= @report.omarchy_version %>.
  Claiming it attaches the snapshot to <%= current_user.email_address %> so you can list from it.
</p>

<%= button_to "Claim this report", claim_report_path(@report.public_id, token: @token), class: button_class + " mt-6" %>
