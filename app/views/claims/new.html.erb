<% page_title "Add this machine" %>

<h1 class="text-3xl font-semibold">Add this machine</h1>
<p class="mt-3 text-muted">
  <%= @report.display_name %> ran Omarchy <%= @report.omarchy_version %>.
  Attach it to <%= current_user.email_address %> and you can list it.
</p>

<%= button_to "Add it to my account", claim_report_path(@report.public_id, token: @token), class: button_class + " mt-6" %>
