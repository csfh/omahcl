<%# vendors: the top Report::Stats::Row list, three at most. total: every machine on record.
    Ranks are shared on a tie, so two vendors with the same count stand level. The list
    is in rank order for a screen reader; order-* puts first place in the middle. %>
<% places = {
     1 => { name: "first", medal: "bg-gold", edge: "border-t-gold", height: "h-24", order: "order-2" },
     2 => { name: "second", medal: "bg-silver", edge: "border-t-silver", height: "h-16", order: "order-1" },
     3 => { name: "third", medal: "bg-bronze", edge: "border-t-bronze", height: "h-12", order: "order-3" }
   } %>
<ol class="flex items-end justify-center gap-2" aria-label="Most reported vendors">
  <% vendors.each do |row| %>
    <% rank = vendors.count { |other| other.count > row.count } + 1 %>
    <% place = places.fetch(rank) %>
    <% slug = Report::Vendor.slug(row.label) %>
    <li class="min-w-0 flex-1 <%= place[:order] %>">
      <% link = slug.present? %>
      <%= content_tag(link ? :a : :div, class: "group flex flex-col items-stretch text-center no-underline hover:no-underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent",
            **(link ? { href: vendor_path(slug) } : {}),
            aria: { label: "#{row.label}, #{place[:name]} place, #{pluralize(row.count, "machine")}, #{number_to_percentage(row.count * 100.0 / total, precision: 0)} of all" }) do %>
        <span class="flex h-14 items-center justify-center text-paper group-hover:text-accent">
          <% if (logo = vendor_logo(row.label, class: "size-12")) %>
            <%= logo %>
          <% else %>
            <span class="font-pixel text-xl" aria-hidden="true"><%= row.label.first.upcase %></span>
          <% end %>
        </span>
        <span class="mt-1 truncate text-xs text-paper group-hover:text-accent" title="<%= row.label %>"><%= row.label %></span>
        <span class="mt-2 flex <%= place[:height] %> flex-col items-center gap-1 border-2 border-t-4 border-line <%= place[:edge] %> bg-panel pt-1.5 group-hover:border-accent">
          <span class="inline-flex size-7 items-center justify-center rounded-full <%= place[:medal] %> font-pixel text-xs text-ink" aria-hidden="true"><%= rank %></span>
          <span class="text-xs tabular-nums text-accent" aria-hidden="true"><%= row.count %></span>
        </span>
      <% end %>
    </li>
  <% end %>
</ol>
