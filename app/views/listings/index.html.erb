<% page_title "Listings" %>

<h1 class="text-3xl font-semibold">Machines for sale or donation</h1>
<p class="mt-2 text-muted">Classifieds only. Market does not take payment or ship anything.</p>

<nav class="mt-6 flex gap-4 text-sm">
  <% { "All" => nil, "Sale" => "sale", "Donation" => "donation" }.each do |label, kind| %>
    <% active = @kind == kind %>
    <%= link_to label, listings_path(kind: kind),
          class: active ? "font-medium text-accent" : "text-paper",
          aria: { current: ("page" if active) } %>
  <% end %>
</nav>

<% if @listings.any? %>
  <ul class="mt-8 grid gap-4 sm:grid-cols-2">
    <% @listings.each do |listing| %>
      <%= render "listings/card", listing: listing %>
    <% end %>
  </ul>
<% elsif @kind %>
  <p class="mt-8 text-muted">
    No <%= @kind == "sale" ? "listings for sale" : "donation listings" %> yet.
    <%= link_to "See all listings", listings_path %>
  </p>
<% else %>
  <p class="mt-8 text-muted">
    No listings yet.
    <%= link_to "How to list a machine", root_path %>
  </p>
<% end %>
