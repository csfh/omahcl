<% page_title "Listings" %>

<h1 class="text-3xl font-semibold">Machines for sale or donation</h1>
<p class="mt-2 text-muted">Classifieds only. Market does not take payment or ship anything.</p>

<nav class="mt-6 flex gap-4 text-sm">
  <%= link_to "All", listings_path, class: params[:kind].blank? ? "text-accent" : "text-paper" %>
  <%= link_to "Sale", listings_path(kind: "sale"), class: params[:kind] == "sale" ? "text-accent" : "text-paper" %>
  <%= link_to "Donation", listings_path(kind: "donation"), class: params[:kind] == "donation" ? "text-accent" : "text-paper" %>
</nav>

<% if @listings.any? %>
  <ul class="mt-8 grid gap-4 sm:grid-cols-2">
    <% @listings.each do |listing| %>
      <%= render "listings/card", listing: listing %>
    <% end %>
  </ul>
<% else %>
  <p class="mt-8 text-muted">No listings yet.</p>
<% end %>
