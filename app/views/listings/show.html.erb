<% page_title @listing.title %>

<p class="text-sm text-muted"><%= link_to "All listings", listings_path %></p>
<h1 class="mt-2 text-3xl font-semibold"><%= @listing.title %></h1>
<p class="mt-2 text-muted">
  <%= @listing.kind %>
  <% if @listing.sale? %> · <%= @listing.condition %> · <%= @listing.price %><% end %>
  <% if @listing.donation? %> · <%= @listing.donation_destination.name %><% end %>
</p>
<p class="mt-1 text-muted"><%= @listing.report.display_name %> · <%= [@listing.city, @listing.country_code].compact.join(", ") %></p>

<% if @listing.photos.attached? %>
  <ul class="mt-8 grid gap-4 sm:grid-cols-2">
    <% @listing.photos.each do |photo| %>
      <li><%= image_tag photo, class: "w-full rounded-md", alt: @listing.title %></li>
    <% end %>
  </ul>
<% end %>

<% if @listing.description.present? %>
  <div class="prose-market mt-8 max-w-2xl">
    <%= simple_format @listing.description %>
  </div>
<% end %>

<p class="mt-8">
  <%= mail_to @listing.user.email_address, "Contact the owner", subject: @listing.title, class: button_class + " no-underline text-ink" %>
</p>

<p class="mt-6 text-sm">
  <%= link_to "Compatibility for this model", hardware_model_path(@listing.report.model_slug) %>
</p>

<% if current_user&.admin? && @listing.published? %>
  <%= button_to "Close listing", close_admin_listing_path(@listing), method: :post, class: ghost_button_class + " mt-6 cursor-pointer", form: { data: { turbo_confirm: "Close this listing?" } } %>
<% end %>
