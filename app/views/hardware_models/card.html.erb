<% page_title "#{@sample.display_name} card" %>
<%= render "hardware_models/og", title: "#{@sample.display_name} is Omarchy Verified", url: card_hardware_model_url(@sample.model_slug) %>

<p class="text-sm text-muted"><%= link_to @sample.display_name, hardware_model_path(@sample.model_slug) %></p>
<h1 class="mt-2 heading-page">Omarchy Verified card</h1>
<p class="mt-2 text-muted">Share it, or tilt it around. It shows only what the model page already shows.</p>

<div class="mt-10 flex justify-center">
  <div class="holo-stage" data-controller="holo-card">
    <article class="holo-card" data-holo-card-target="card" aria-label="Omarchy Verified: <%= @sample.display_name %>">
      <div class="holo-foil" aria-hidden="true"></div>
      <div class="holo-sparkle" aria-hidden="true"></div>
      <div class="holo-glare" aria-hidden="true"></div>

      <div class="holo-content">
        <p class="font-pixel text-[0.6rem] leading-relaxed text-accent">Omarchy Verified</p>

        <svg class="holo-seal" viewBox="0 0 10 10" aria-hidden="true" shape-rendering="crispEdges">
          <path class="fill-teal-deep" d="M3 0h4v10h-4zM1 1h8v8h-8zM0 3h10v4h-10z" />
          <path class="fill-accent" d="M3 1h4v8h-4zM2 2h6v6h-6zM1 3h8v4h-8z" />
          <path class="fill-ink" d="<%= CardImage::CHECK.map { |x, y| "M#{x} #{y}h1v1h-1z" }.join %>" />
        </svg>

        <div>
          <h2 class="font-pixel text-xs leading-relaxed text-paper"><%= @sample.display_name %></h2>
          <dl class="mt-3 space-y-1 text-xs text-muted">
            <div class="flex justify-between gap-3"><dt>CPU</dt><dd class="text-right text-paper"><%= @card[:cpu] %></dd></div>
            <div class="flex justify-between gap-3"><dt>GPU</dt><dd class="text-right text-paper"><%= @card[:gpu] %></dd></div>
            <div class="flex justify-between gap-3"><dt>Omarchy</dt><dd class="text-right text-paper"><%= @card[:version] %></dd></div>
          </dl>
        </div>

        <p class="flex items-center justify-between text-[0.65rem] text-muted">
          <span><%= pluralize(@card[:machines], "machine") %></span>
          <span>omahcl.com</span>
        </p>
      </div>
    </article>
  </div>
</div>

<p class="mt-8 text-center">
  <%= link_to "Download as an image (PNG)", card_hardware_model_path(@sample.model_slug, format: :png),
        class: ghost_button_class, download: "omarchy-verified-#{@sample.model_slug}.png" %>
</p>
