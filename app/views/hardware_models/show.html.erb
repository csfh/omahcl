<% page_title @sample.display_name %>

<p class="text-sm text-muted"><%= link_to "All models", hardware_models_path %></p>
<h1 class="mt-2 text-3xl font-semibold"><%= @sample.display_name %></h1>
<p class="mt-2 text-muted">
  <%= pluralize(@claimants_count, "person") %> <%= @claimants_count == 1 ? "has" : "have" %> claimed this model after submitting from Omarchy.
  <%= evidence_label(@claimants_count) %>.
</p>

<dl class="mt-8 grid gap-4 sm:grid-cols-2">
  <div class="rounded-md bg-panel p-4">
    <dt class="text-sm text-muted">Memory seen</dt>
    <dd class="mt-1"><%= memory_label(@reports.minimum(:memory_bytes)) %> – <%= memory_label(@reports.maximum(:memory_bytes)) %></dd>
  </div>
  <div class="rounded-md bg-panel p-4">
    <dt class="text-sm text-muted">CPU models</dt>
    <dd class="mt-1"><%= @cpu_models.join(", ") %></dd>
  </div>
  <div class="rounded-md bg-panel p-4">
    <dt class="text-sm text-muted">GPUs</dt>
    <dd class="mt-1"><%= @gpus.map { |gpu| [gpu["vendor"], gpu["name"]].compact.join(" ") }.uniq.join(", ").presence || "None reported" %></dd>
  </div>
  <div class="rounded-md bg-panel p-4">
    <dt class="text-sm text-muted">Omarchy versions</dt>
    <dd class="mt-1"><%= @versions.join(", ") %></dd>
  </div>
</dl>

<% if @listings.any? %>
  <h2 class="mt-10 text-lg font-medium">Listed machines</h2>
  <ul class="mt-4 grid gap-4 sm:grid-cols-2">
    <% @listings.each do |listing| %>
      <%= render "listings/card", listing: listing %>
    <% end %>
  </ul>
<% end %>
