<% page_title "Omarchy hardware" %>

<section class="hero border-2 border-line p-6">
  <p class="inline-block border-2 border-line bg-panel px-3 py-1 text-xs text-accent">Unofficial community database. Not affiliated with Omarchy.</p>
  <h1 class="wordmark mt-5 uppercase">Omarchy HCL</h1>
  <p class="mt-4 text-lg font-semibold">What hardware runs Omarchy?</p>
  <p class="mt-2 max-w-prose text-sm text-muted">Every machine listed here was reported by someone running Omarchy on it.</p>
  <%= render "hardware_models/lookup_form", query: @query, submit_label: "Look up" %>
</section>

<% if @models.any? %>
  <section class="mt-12">
    <h2 class="heading-section">Machines people run</h2>
    <ul class="mt-4 divide-y-2 divide-line border-y-2 border-line">
      <% @models.each do |model| %>
        <li class="flex items-center justify-between gap-4 py-3">
          <%= link_to "#{model.vendor} #{model.product}", hardware_model_path(model.model_slug), class: "text-paper no-underline hover:text-accent" %>
          <%= machines_status(model.machines_count, model.networks_count) %>
        </li>
      <% end %>
    </ul>
    <p class="mt-4"><%= link_to "See every machine", hardware_models_path %></p>
  </section>
<% end %>

<section id="report" class="mt-12 max-w-2xl scroll-mt-6">
  <h2 class="heading-section">Report your machine</h2>
  <p class="mt-2 text-muted">Run this in a terminal. It shows what it would send, explains the privacy policy and sends nothing unless you say yes. On Omarchy a yes adds a public report. Anywhere else it first checks your machine locally, and a yes adds a private candidate report.</p>
  <div class="mt-4">
    <%= render "application/collect_command" %>
  </div>
  <p class="mt-2 text-sm text-muted">No account is needed. Read the script first at <%= link_to "/collect", collect_path %>, and see <%= link_to "what we keep", privacy_path %>.</p>
</section>
