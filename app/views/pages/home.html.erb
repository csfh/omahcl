<% page_title "Omarchy hardware" %>
<% content_for :description, "An unofficial public database of the hardware that runs Omarchy. See which machines work, or report yours with one command." %>

<section class="hero grid gap-8 border-2 border-line p-6 md:grid-cols-2 md:items-center">
  <div class="min-w-0">
    <p class="inline-block border-2 border-line bg-panel px-3 py-1 text-xs text-accent">Unofficial community database. Not affiliated with Omarchy.</p>
    <h1 class="wordmark mt-5 uppercase">Omarchy HCL</h1>
    <p class="mt-4 text-lg font-semibold">What hardware runs Omarchy?</p>
    <p class="mt-2 max-w-prose text-sm text-muted">Every machine listed here was reported by someone running Omarchy on it.</p>
    <%= render "hardware_models/lookup_form", query: @query, submit_label: "Look up" %>
    <% if @stats.machines.positive? %>
      <div class="mt-8 max-w-sm">
        <h2 class="text-sm font-semibold text-paper">Most reported vendors</h2>
        <div class="mt-3"><%= render "stats/podium", vendors: @stats.vendors.first(3), total: @stats.machines %></div>
        <p class="mt-3 text-xs text-muted">Pick one for its most reported machines. Logos belong to their owners and only name the vendor.</p>
      </div>
    <% end %>
  </div>
  <div class="min-w-0 border-2 border-line bg-panel p-4">
    <h2 class="text-sm font-semibold text-paper">Get your card</h2>
    <% if @featured_card %>
      <p class="mt-2 text-sm text-muted">Report your machine and get a card like this.</p>
      <%= link_to card_path(@featured_card.card_key), class: "mt-3 block", aria: { label: "Omarchy Verified card for #{@featured_card.display_name(short: true)}" } do %>
        <%= image_tag card_path(@featured_card.card_key, format: :png), width: 1200, height: 630, alt: "Omarchy Verified card for #{@featured_card.display_name(short: true)}", class: "h-auto w-full border-2 border-line" %>
      <% end %>
    <% else %>
      <p class="mt-2 text-sm text-muted">Report your machine and get an Omarchy Verified card.</p>
    <% end %>
    <p class="mt-4 text-sm text-muted">Run this in a terminal. It sends nothing unless you say yes.</p>
    <div class="mt-4">
      <%= render "application/collect_command", command: collect_command %>
    </div>
    <p class="mt-2 text-sm text-muted">Run it again after an Omarchy update to refresh the version on your card. Read the script first at <%= link_to "/collect", collect_path %>.</p>
  </div>
</section>

<% if @recent_models.any? %>
  <section class="mt-12" aria-labelledby="just-reported">
    <h2 id="just-reported" class="heading-section">Just reported</h2>
    <ul class="mt-4 divide-y-2 divide-line border-y-2 border-line">
      <% @recent_models.each do |model| %>
        <li class="flex flex-wrap items-center justify-between gap-x-4 gap-y-1 py-1">
          <%= link_to model.display_name, hardware_model_path(model.model_slug), class: "inline-flex min-h-11 min-w-0 items-center wrap-anywhere text-paper no-underline hover:text-accent active:text-accent" %>
          <span class="text-sm text-muted"><%= time_ago_in_words(model.reported_at) %> ago</span>
        </li>
      <% end %>
    </ul>
  </section>
<% end %>

<%= render "stats/dashboard", stats: @stats if @stats.machines.positive? %>

<% if @models.any? %>
  <section class="mt-12">
    <h2 class="heading-section">Machines people run</h2>
    <ul class="mt-4 divide-y-2 divide-line border-y-2 border-line">
      <% @models.each do |model| %>
        <li class="flex items-center justify-between gap-4 py-1">
          <%= link_to model.display_name, hardware_model_path(model.model_slug), class: "inline-flex min-h-11 min-w-0 items-center wrap-anywhere text-paper no-underline hover:text-accent active:text-accent" %>
          <%= machines_status(model.machines_count) %>
        </li>
      <% end %>
    </ul>
    <p class="mt-4"><%= link_to "See every machine", hardware_models_path, class: "inline-flex min-h-11 items-center" %></p>
  </section>
<% end %>

<section id="report" class="mt-12 max-w-2xl scroll-mt-6">
  <h2 class="heading-section">Report your machine</h2>
  <p class="mt-2 text-muted">Run this in a terminal. A yes publishes your machine's model page and an Omarchy Verified card, and the script prints the link to the card. Before that it shows what it would send, explains the privacy policy and sends nothing unless you say yes. It only reports machines running Omarchy, and on any other system it sends nothing.</p>
  <div class="mt-4">
    <%= render "application/collect_command", command: collect_command %>
  </div>
  <p class="mt-2 text-sm text-muted">Run it again after an Omarchy update to refresh the version on your card. No account is needed. Read the script first at <%= link_to "/collect", collect_path %>, and see <%= link_to "what we keep", privacy_path %>.</p>
  <h3 class="mt-6 text-sm text-paper">Remove your machine</h3>
  <p class="mt-2 text-sm text-muted">This rebuilds your machine's hash and asks before it deletes any report you sent. Read it at <%= link_to "/delete", delete_script_path %>.</p>
  <div class="mt-4">
    <%= render "application/collect_command", command: delete_command %>
  </div>
</section>
