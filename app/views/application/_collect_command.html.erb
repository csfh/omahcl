<div class="flex items-stretch gap-2" data-controller="clipboard">
  <pre class="min-w-0 flex-1 overflow-x-auto panel text-sm text-paper"><code data-clipboard-target="source"><%= command %></code></pre>
  <button type="button" class="<%= ghost_button_class %> shrink-0 cursor-pointer justify-center" data-action="clipboard#copy" data-clipboard-target="button">
    Copy
  </button>
  <p class="sr-only" aria-live="polite" data-clipboard-target="status"></p>
</div>
