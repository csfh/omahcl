<% page_title "Sign up" %>

<h1 class="text-3xl font-semibold">Create an account</h1>
<p class="mt-2 text-muted">You need an account to claim a report and list from it. We'll email a verification link.</p>

<%= form_with model: @user, url: registration_path, id: "signup", data: { turbo: false }, class: "mt-6 max-w-md space-y-5" do |form| %>
  <% if @user.errors.any? %>
    <div class="rounded-md border border-red-400/40 bg-red-400/10 px-3 py-2 text-sm text-red-200" role="alert">
      <ul class="list-disc pl-5">
        <% @user.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :email_address, "Email", for: "email", class: "text-sm text-muted" %>
    <%= form.email_field :email_address, id: "email", required: true, autofocus: true, autocomplete: "email", class: field_class %>
  </div>
  <div>
    <%= form.label :password, for: "new-password", class: "text-sm text-muted" %>
    <%= form.password_field :password, id: "new-password", required: true, autocomplete: "new-password", maxlength: 72, passwordrules: "maxlength: 72;", class: field_class %>
  </div>
  <div>
    <%= form.label :password_confirmation, "Confirm password", for: "confirm-password", class: "text-sm text-muted" %>
    <%= form.password_field :password_confirmation, id: "confirm-password", required: true, autocomplete: "new-password", maxlength: 72, passwordrules: "maxlength: 72;", class: field_class %>
  </div>
  <%= form.submit "Sign up", class: button_class %>
<% end %>

<p class="mt-6 text-sm text-muted">Already have an account? <%= link_to "Sign in", new_session_path %></p>
